# PackVote Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/packvote

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# Free tier: 300 emails/day — https://app.brevo.com
# Get your API key: Brevo dashboard → Account → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender in Brevo (Settings → Senders). For testing, add and verify your Gmail address.
BREVO_FROM_EMAIL=you@gmail.com

# ── AI Providers ──────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Default: Google Gemini free tier.
# Key: https://aistudio.google.com/apikey

AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_PROVIDER_NAME=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash
# Gemini draws thinking tokens from the max_tokens budget; 0 disables the
# thinking pass so it cannot truncate the itinerary JSON.
# Gemini 3.x uses {"thinking_level": "low"} instead of thinking_budget.
AI_EXTRA_BODY={"google": {"thinking_config": {"thinking_budget": 0}}}


# ── Unsplash ──────────────────────────────────────────────────────────────────
# Travel photography — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
